# Secrets para wrangler dev / producción. NO commitear el .dev.vars real.
# Copia este archivo a .dev.vars y rellena los valores.

# Habilita el preview del magic link en dev (Fix 3, ver AGENTS.md §9).
# Si HTMLBOX_ENV === 'production' en runtime, NUNCA se devuelve _dev_preview
# en respuestas de auth (evita bypass de auth cuando el email service falla
# en prod-fallback). En dev lo seteamos en 'development' para que el preview
# siga funcionando.
HTMLBOX_ENV=development

# Auth: origen del Worker `auth` para el flujo de exchange (ticket → cookie).
# El control-plane hace fetch server-to-server a este origen cuando llega un
# `?st=...` de /auth/exchange. Mismo valor que portal y runtime.
HTMLBOX_AUTH_ORIGIN=http://auth.localhost:8785

# Auth: clave HMAC para firmar/verificar cookies de sesión sid
HTMLBOX_SESSION_SECRET=dev-secret-change-me-please-32chars-min

# Turso Platform API (https://api.turso.io/v1) — solo se usa en HTMLBOX_TURSO_MODE=cloud.
# En local (dev), wrangler no necesita este secret: connectamos a sqld vía HTMLBOX_TURSO_DEV_URL.
HTMLBOX_TURSO_PLATFORM_TOKEN=
HTMLBOX_TURSO_ORG=

# R2 access keys para presigned URLs (S3-compatible).
# En dev, wrangler emite las suyas propias vía el binding BUCKET; este par solo se
# usa si necesitamos firmar URLs fuera del Worker.
HTMLBOX_R2_ACCESS_KEY_ID=
HTMLBOX_R2_SECRET_ACCESS_KEY=

# Origen del portal (para redirigir después del magic-link login).
# Sobreescribe el valor default de wrangler.jsonc#vars para dev.
HTMLBOX_PORTAL_ORIGIN=http://studio.localhost:8782

# Secreto compartido entre control-plane y runtime (A3). El runtime debe
# mandar este valor en el header X-HTMLBox-Internal-Secret al llamar a
# /api/internal/boxes/:id/db, /api/internal/boxes/:id/membership y
# /api/internal/whoami — sin él, el control-plane rechaza con 403.
# Generá uno con:  openssl rand -hex 32
# En prod usá:  wrangler secret put HTMLBOX_INTERNAL_SECRET
# (en ambos Workers, control-plane y runtime, con el MISMO valor).
HTMLBOX_INTERNAL_SECRET=

# Modo email: prod en dev también.
# Por qué: el flow-engine lee esta var (en el nodo `cloudflare-email`) para
# decidir si invoca el binding `EMAIL` (prod = real) o solo loguea el link
# (dev = dry-run). Querés que en dev el email también llegue al inbox real
# (no más "consolá y copiá el link" — operativo desde el browser).
# El gate Fix 3 sigue protegiendo prod: HTMLBOX_ENV=production hace que
# routes/auth.js NO incluya `_dev_preview` en la respuesta.
# Para tests sin binding (CI, mocks), podés volver al dry-run vía override:
#   npx wrangler dev --remote --port 8781 --var HTMLBOX_EMAIL_MODE:dev
HTMLBOX_EMAIL_MODE=prod
