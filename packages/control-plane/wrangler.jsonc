{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlbox-control-plane",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "rules": [
    { "type": "Text", "globs": ["src/ui-partials/*.txt"], "fallthrough": true }
  ],

  "dev": {
    "ip": "0.0.0.0",
    "port": 8781,
    "inspector_port": 9229,
    "inspector_ip": "127.0.0.1"
  },

"vars": {
    "HTMLBOX_ENV": "production",
    "HTMLBOX_TURSO_MODE": "cloud",
    "HTMLBOX_SESSION_DOMAIN": ".htmlbox.dev",
    "HTMLBOX_RUNTIME_ORIGIN": "https://htmlbox.dev",
    "HTMLBOX_PUBLIC_ORIGIN": "https://controlplane.htmlbox.dev",
    "HTMLBOX_PORTAL_ORIGIN": "https://portal.htmlbox.dev",
    "HTMLBOX_EMAIL_MODE": "prod",
    "HTMLBOX_EMAIL_FROM_ADDRESS": "no-reply@htmlbox.dev",
    "HTMLBOX_EMAIL_FROM_NAME": "HTMLBox",
    "HTMLBOX_ADMIN_VERSION": "0.1.0",
    "HTMLBOX_CLOUDFLARE_ACCOUNT_ID": "bbd6bb71e68887eb0fa9cc8e872ed588",
    "HTMLBOX_WFP_NAMESPACE": "htmlbox-boxes"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htmlbox-control-plane",
      "database_id": "7ac72bf3-63ae-4789-9679-ab869419fa2a",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "htmlbox-content" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "0388238bb30747819a845f94e1373390" }
  ],

  "send_email": [
    { "name": "MAIL" }
  ],

  "assets": {
    "directory": "./src/ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "observability": { "enabled": true }
}