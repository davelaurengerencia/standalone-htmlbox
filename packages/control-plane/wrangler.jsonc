{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlbox-control-plane",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "rules": [
    { "type": "Text", "globs": ["src/ui-partials/*.txt"], "fallthrough": true },
    { "type": "Text", "globs": ["src/flows/*.flow.json"], "fallthrough": true }
  ],

  "dev": {
    "ip": "::",
    "port": 8781,
    "inspector_port": 9229,
    "inspector_ip": "127.0.0.1"
  },

  // === TOP-LEVEL (PROD) ===
  // Custom domain — controlplane.sivocloud.dev.
  // El patrón DEBE terminar en `/*` para que matchee subpaths — sin el
  // `/*`, Cloudflare solo matchea el path raíz `/` (confirmado: el worker
  // recibe `/` pero cuelga en 522 para `/api/auth/me`, `/health`, etc.).
  // NO usamos custom_domain: true porque la zona ya tiene A records
  // placeholder (192.0.2.x) que CF marca como "externally managed" y
  // rompen el endpoint /domains/records. Los routes solos funcionan
  // igual — el wildcard A record ya está proxied en la zona.
  "routes": [
    { "pattern": "controlplane.sivocloud.dev/*", "zone_name": "sivocloud.dev" }
  ],

  "vars": {
    "HTMLBOX_ENV": "production",
    "HTMLBOX_TURSO_MODE": "cloud",
    "HTMLBOX_SESSION_DOMAIN": ".sivocloud.dev",
    "HTMLBOX_RUNTIME_ORIGIN": "https://sivocloud.dev",
    "HTMLBOX_PUBLIC_ORIGIN": "https://controlplane.sivocloud.dev",
    "HTMLBOX_PORTAL_ORIGIN": "https://studio.sivocloud.dev",
    "HTMLBOX_AUTH_ORIGIN": "https://auth.sivocloud.dev",
    "HTMLBOX_EMAIL_MODE": "prod",
    "HTMLBOX_EMAIL_FROM_ADDRESS": "no-reply@sivocloud.dev",
    "HTMLBOX_EMAIL_FROM_NAME": "SivoCloud",
    "HTMLBOX_ADMIN_VERSION": "0.1.0",
    "HTMLBOX_CLOUDFLARE_ACCOUNT_ID": "bbd6bb71e68887eb0fa9cc8e872ed588",
    "HTMLBOX_WFP_NAMESPACE": "htmlbox-boxes"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htmlbox-control-plane",
      "database_id": "7ac72bf3-63ae-4789-9679-ab869419fa2a",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "htmlbox-content" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "0388238bb30747819a845f94e1373390" }
  ],

  "send_email": [
    { "name": "EMAIL" }
  ],

  "assets": {
    "directory": "./src/ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Worker Loader (Dynamic Workers) — ver packages/auth/wrangler.jsonc para el
  // comentario completo sobre por qué hace falta. Sin este binding, los nodos
  // `function` de los flows magic-link / app-magic-link fallan en producción
  // con "Code generation from strings disallowed".
  "worker_loaders": [
    { "binding": "LOADER" }
  ],

  "observability": { "enabled": true }
}