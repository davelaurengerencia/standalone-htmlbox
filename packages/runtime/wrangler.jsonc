{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlbox-runtime",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "dev": {
    "ip": "::",
    "port": 8783,
    "inspector_port": 9231,
    "inspector_ip": "127.0.0.1"
  },

  // === TOP-LEVEL (PROD) ===
  // El apex sivocloud.dev lo sirve el worker landing (packages/landing/).
  // Acá solo manejamos el wildcard — cubre {tenant}.sivocloud.dev (boxes)
  // Y cualquier subdominio explícito (ej: runtime.sivocloud.dev, aunque
  // hoy no se use, queda disponible para futuras herramientas).
  // El patrón DEBE terminar en `/*` para matchear subpaths — sin el
  // `/*`, Cloudflare solo matchea el path raíz `/` (confirmado).
  "routes": [
    { "pattern": "*.sivocloud.dev/*", "zone_name": "sivocloud.dev" }
  ],

  "vars": {
    "HTMLBOX_ENV": "production",
    "HTMLBOX_CONTROL_PLANE_ORIGIN": "https://controlplane.sivocloud.dev"
  },

  "rules": [
    { "type": "Text", "globs": ["src/sdk/*.txt", "src/devtools/*.txt"], "fallthrough": true }
  ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "htmlbox-content" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "0388238bb30747819a845f94e1373390" }
  ],

  // Phase 2 (WFP encendido): el dispatch namespace 'htmlbox-boxes' tiene
  // un script por box (deployed por control-plane/routes/boxes.js al crear
  // el box vía wfpDeployer). El dispatcher (packages/runtime/src/lib/boxDispatch.js)
  // hace .get("box-{boxId}").fetch(request) — si el script no existe en el
  // namespace, devuelve null y el dispatcher cae al path viejo
  // (fetchActiveHtml + serveBoxHtml).
  //
  // `remote: true` es REQUERIDO — wrangler --local NO emula dispatch
  // namespaces (warning explícito en cada boot). Con `remote: true`, las
  // llamadas .get()/.fetch() van contra el namespace real en Cloudflare.
  // Costo: una llamada extra cross-network por cada GET, pero a cambio
  // podés testear el ciclo WFP completo desde local sin deployar runtime.
  //
  // Si esto falla o el namespace se borra accidentalmente, todos los boxes
  // siguen sirviendo por el path viejo (graceful degradation).
  "dispatch_namespaces": [
    { "binding": "BOX_DISPATCH", "namespace": "htmlbox-boxes", "remote": true }
  ],

  "observability": { "enabled": true }
}