{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlbox-runtime",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "dev": {
    "ip": "0.0.0.0",
    "port": 8783,
    "inspector_port": 9231,
    "inspector_ip": "127.0.0.1"
  },

  "rules": [
    { "type": "Text", "globs": ["src/sdk/*.txt", "src/devtools/*.txt"], "fallthrough": true }
  ],

  "vars": {
    "HTMLBOX_ENV": "production",
    "HTMLBOX_CONTROL_PLANE_ORIGIN": "https://controlplane.htmlbox.dev"
  },

  "routes": [
    { "pattern": "htmlbox.dev", "zone_name": "htmlbox.dev", "custom_domain": true },
    { "pattern": "*.htmlbox.dev", "zone_name": "htmlbox.dev" }
  ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "htmlbox-content" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "0388238bb30747819a845f94e1373390" }
  ],

  // Phase 2 (WFP encendido): el dispatch namespace 'htmlbox-boxes' tiene
  // un script por box (deployed por control-plane/routes/boxes.js al crear
  // el box vía wfpDeployer). El dispatcher (packages/runtime/src/lib/boxDispatch.js)
  // hace .get("box-{boxId}").fetch(request) — si el script no existe en el
  // namespace, devuelve null y el dispatcher cae al path viejo
  // (fetchActiveHtml + serveBoxHtml).
  //
  // Si esto falla o el namespace se borra accidentalmente, todos los boxes
  // siguen sirviendo por el path viejo (graceful degradation).
  "dispatch_namespaces": [
    { "binding": "BOX_DISPATCH", "namespace": "htmlbox-boxes" }
  ],

  "observability": { "enabled": true }
}