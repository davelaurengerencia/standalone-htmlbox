{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlbox-portal",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "dev": {
    "ip": "::",
    "port": 8782,
    "inspector_port": 9230,
    "inspector_ip": "127.0.0.1"
  },

  // === TOP-LEVEL (PROD) ===
  // Custom domain — studio.sivocloud.dev.
  // El patrón DEBE terminar en `/*` para matchear subpaths.
  // NO usamos custom_domain: true (mismo motivo que control-plane:
  // la zona tiene A records placeholder que CF marca como externally
  // managed). El rename del host es solo cosmético — el paquete y el
  // worker name siguen siendo "htmlbox-portal" internamente.
  "routes": [
    { "pattern": "studio.sivocloud.dev/*", "zone_name": "sivocloud.dev" }
  ],

  // Service binding al control-plane para el proxy /api/*.
  // Por qué NO fetch() al URL público: en wrangler 4.127+, los fetches
  // worker-to-worker via custom domain en la misma zona cuelgan en 20s
  // (522). Service binding es interno (no sale al edge), zero-latency, y
  // no tiene ese problema. Mismo patrón que landing → runtime.
  "services": [
    { "binding": "CONTROL_PLANE", "service": "htmlbox-control-plane" }
  ],

  "vars": {
    "HTMLBOX_ENV": "production",
    "HTMLBOX_CONTROL_PLANE_ORIGIN": "https://controlplane.sivocloud.dev",
    "HTMLBOX_RUNTIME_ORIGIN": "https://sivocloud.dev",
    "HTMLBOX_PORTAL_VERSION": "0.1.0",
    "HTMLBOX_AUTH_ORIGIN": "https://auth.sivocloud.dev"
  },

  "rules": [
    { "type": "Text", "globs": ["src/ui/*.txt", "src/ui-partials/*.txt"], "fallthrough": true }
  ],

  "assets": {
    "directory": "./src/ui",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  },

  "observability": { "enabled": true }
}